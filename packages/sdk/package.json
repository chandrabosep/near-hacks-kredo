{
  "name": "kredo",
  "version": "0.2.1",
  "description": "Server kit for charging Kredo credits from a company backend",
  "license": "MIT",
  "homepage": "https://kredo-near.vercel.app/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandrabosep/near-hacks-kredo.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "kredo",
    "credits",
    "payments",
    "usdt",
    "near",
    "sdk"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "e2e": "tsx examples/e2e.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "near-api-js": "7.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
