{
  "name": "kredo-react",
  "version": "0.2.0",
  "description": "Kredo buttons and balance for any React app",
  "license": "MIT",
  "homepage": "https://kredo-near.vercel.app/docs/react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandrabosep/near-hacks-kredo.git",
    "directory": "packages/react"
  },
  "keywords": [
    "kredo",
    "credits",
    "payments",
    "react",
    "usdt",
    "near"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.3.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
