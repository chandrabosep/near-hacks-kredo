# Read by forge script/Deploy.s.sol. All optional: each defaults to the deployer address.
# Sign deploys with `cast wallet import deployer --interactive` and `--account deployer`,
# so no private key ever sits in this file.

OWNER=
OPERATOR=
FEE_RECIPIENT=

# Local chains only. Leave empty to deploy a fresh MockUSDT.
# On Whitechain Sepolia (1874) the official test USDT is always used.
USDT=
