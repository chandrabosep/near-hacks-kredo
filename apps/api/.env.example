PORT=4000

# 31337 for a local anvil chain, 1874 for Whitechain Sepolia.
CHAIN_ID=31337
# Defaults: http://127.0.0.1:8545 locally, https://rpc.testnet.whitechain.io on 1874.
RPC_URL=

# The relayer key. It pays all gas and must be an operator on the vault.
# Required on 1874. Locally it defaults to anvil's first account.
OPERATOR_KEY=

# Read from contracts/deployments/<CHAIN_ID>.json unless both are set.
VAULT_ADDRESS=
USDT_ADDRESS=
START_BLOCK=

DATA_DIR=./data
TX_TIMEOUT_MS=60000

# Privy (dashboard.privy.io): email login and embedded wallets for users.
# Enable identity tokens in the dashboard. Without these, user routes answer 503.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Our hosted pages, allowed to call user routes with cookies. Comma separated.
WEB_ORIGINS=http://localhost:3000

# Guards /v1/admin. Locally it defaults to "dev-admin".
ADMIN_TOKEN=

NETWORK_FEE_BPS=500
RATE_LIMIT_PER_MIN=120
HOLD_TTL_SECONDS=3600

# Relayer limits: what stops a drain. Checked before sending, so a refused transaction costs nothing.
# Most WBT spent in any rolling 24 hours, overall and per app.
RELAYER_DAILY_BUDGET=0.25
APP_DAILY_GAS_BUDGET=0.1
# Below this WBT balance, only exits go out (release, payout, revoke, cancel claim).
RELAYER_MIN_BALANCE=0.05
# Per-transaction ceilings.
MAX_TX_GAS=500000
MAX_GAS_PRICE_GWEI=50

# Indexer: poll interval, and blocks per eth_getLogs call (Whitechain's RPC allows 1,000).
INDEXER_INTERVAL_MS=2000
LOG_CHUNK=1000
