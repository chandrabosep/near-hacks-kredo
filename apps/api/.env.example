PORT=4000

# NEAR network: testnet or mainnet.
NEAR_NETWORK=testnet
# Defaults to the network's public RPC and NearBlocks.
NEAR_RPC_URL=
EXPLORER_URL=

# Read from contracts/deployments/<NEAR_NETWORK>.json unless set.
VAULT_ACCOUNT_ID=
USDT_ACCOUNT_ID=
# The relayer signs every transaction and pays its gas. It must be an operator on the vault.
RELAYER_ACCOUNT_ID=
# Its key, ed25519:... Without it, the key is read from near-cli's credentials folder.
RELAYER_PRIVATE_KEY=
NEAR_CREDENTIALS_DIR=~/.near-credentials

# Postgres connection string. Without it, an embedded Postgres is kept under DATA_DIR.
DATABASE_URL=
DATA_DIR=./data

# Privy (dashboard.privy.io): email login and an embedded NEAR wallet for each user.
# Enable identity tokens in the dashboard. Without these, user routes answer 503.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Our hosted pages, allowed to call user routes with cookies. Comma separated.
WEB_ORIGINS=http://localhost:3000

# Guards /v1/admin. Without it, admin routes are off.
ADMIN_TOKEN=

NETWORK_FEE_BPS=500
RATE_LIMIT_PER_MIN=120
HOLD_TTL_SECONDS=3600

# Relayer limits: what stops a drain. Checked before sending, so a refused transaction costs nothing.
# Most NEAR spent in any rolling 24 hours, overall and per app.
RELAYER_DAILY_BUDGET=1
APP_DAILY_GAS_BUDGET=0.5
# Below this NEAR balance, only exits go out (release, payout, revoke, cancel claim).
RELAYER_MIN_BALANCE=0.3
# Most gas one transaction may attach, in Tgas.
MAX_TX_TGAS=300
# NEAR sent to a new user's implicit account so it exists onchain.
USER_ACCOUNT_NEAR=0.01
# Vault storage the relayer pays for each user, in NEAR: registered with the vault's minimum plus
# the headroom, and topped up before a new app limit or claim link when less than TOP_UP_BELOW is left.
VAULT_STORAGE_HEADROOM=0.005
VAULT_STORAGE_TOP_UP_BELOW=0.0025
VAULT_STORAGE_TOP_UP=0.005
# Vault storage put on each new app's signer account once, at registration (NEAR). Pays for its charges' refs.
APP_SIGNER_STORAGE=0.5
# Parent of the apps' signer accounts: an app signs from <app id>.<this>. Defaults to appsParent in the deployment file.
# APPS_PARENT_ACCOUNT_ID=apps.kredo-network.testnet

# How often to release expired holds, retry webhooks and check the vault's backing.
INDEXER_INTERVAL_MS=5000

# Smallest charge or hold, and smallest send or claim link, in credits. Dust would only burn gas.
MIN_CHARGE_CREDITS=1
MIN_SEND_CREDITS=1
# New accounts and claim redemptions allowed per IP, per hour.
SIGNUPS_PER_IP_PER_HOUR=20
CLAIMS_PER_IP_PER_HOUR=10

# Test USDT for new users, sent from the relayer account so anyone can try the network.
# Once per account, only while their wallet is nearly empty. 0 turns it off.
FAUCET_USDT=0.5
FAUCET_DAILY_LIMIT=40
FAUCET_PER_IP_PER_HOUR=3
