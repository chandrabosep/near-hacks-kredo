PORT=4000

# 31337 for a local anvil chain, 1874 for Whitechain Sepolia.
CHAIN_ID=31337
# Defaults: http://127.0.0.1:8545 locally, https://rpc.testnet.whitechain.io on 1874.
RPC_URL=

# The relayer key. It pays all gas and must be an operator on the vault.
# Required on 1874. Locally it defaults to anvil's first account.
OPERATOR_KEY=

# Read from contracts/deployments/<CHAIN_ID>.json unless both are set.
VAULT_ADDRESS=
USDT_ADDRESS=
START_BLOCK=

DATA_DIR=./data
TX_TIMEOUT_MS=60000
