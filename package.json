{
  "name": "kredo-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "demos/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @credits/web",
    "dev:api": "npm run dev -w @credits/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "contracts:fork": "cd contracts && FORK=1 forge test --match-path \"test/fork/*\" -vv",
    "test:api": "npm test -w @credits/api",
    "abi": "npm run abi -w @credits/api",
    "test:sdk": "npm test -w kredo",
    "dev:local": "scripts/dev-local.sh",
    "fund:local": "scripts/fund-local.sh",
    "deploy:whitechain": "scripts/deploy-whitechain.sh",
    "start:whitechain": "scripts/start-whitechain.sh",
    "dev:parley": "npm run dev -w @demo/parley",
    "demos:keys": "scripts/demo-keys.sh"
  }
}
