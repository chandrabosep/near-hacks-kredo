{
  "name": "kredo-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "demos/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @credits/web",
    "dev:api": "npm run dev -w @credits/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "contracts:build": "cd contracts && cargo near build non-reproducible-wasm --manifest-path vault/Cargo.toml && cargo near build non-reproducible-wasm --manifest-path usdt/Cargo.toml",
    "contracts:test": "cd contracts && cargo test",
    "test:api": "npm test -w @credits/api",
    "test:sdk": "npm test -w kredo",
    "dev:local": "scripts/dev-local.sh",
    "fund:testnet": "scripts/fund-testnet.sh",
    "dev:parley": "npm run dev -w @demo/parley",
    "dev:lumen": "npm run dev -w @demo/lumen",
    "demos:keys": "scripts/demo-keys.sh"
  }
}
