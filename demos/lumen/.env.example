# From the Kredo dashboard, or `npm run demos:keys` from the repo root. Keep it on the server.
CREDITS_API_KEY=
# This app's own signing key (ed25519:...): the only key on its signer account, a function-call
# key limited to the vault's charge methods. Charges are signed with it here. Keep it on the server.
CREDITS_SIGNER_KEY=
# Kredo's API and hosted pages. These defaults are the local network.
CREDITS_API_URL=http://localhost:4000
NEXT_PUBLIC_CREDITS_PAGES_URL=http://localhost:3000

# Optional. A fal.ai key for real images and video. Without it Lumen runs in demo mode with
# sample media; billing is still live.
FAL_KEY=
