# From the Kredo dashboard, or `npm run demos:keys` from the repo root. Keep it on the server.
CREDITS_API_KEY=
# Kredo's API and hosted pages. These defaults are the local network.
CREDITS_API_URL=http://localhost:4000
NEXT_PUBLIC_CREDITS_PAGES_URL=http://localhost:3000

# Optional. Without it Parley runs in demo mode with sample replies; billing is still live.
ANTHROPIC_API_KEY=
